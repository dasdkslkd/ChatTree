{
  "name": "chattree",
  "private": true,
  "version": "0.1.16",
  "description": "ChatTree desktop client",
  "author": "ChatTree contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/dasdkslkd/ChatTree.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test \"test/*.test.cjs\" \"test/*.test.mjs\"",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.0",
    "@types/dagre": "^0.7.54",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "dayjs": "^1.11.19",
    "diff": "^9.0.0",
    "electron-updater": "6.8.9",
    "katex": "^0.16.27",
    "lucide-react": "^0.575.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-markdown-mermaid": "",
    "react-syntax-highlighter": "",
    "react-virtuoso": "",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/mdast": "^4.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "shadcn": "^3.8.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "build": {
    "appId": "com.chattree.app",
    "productName": "ChatTree",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "electronUpdaterCompatibility": ">=2.16",
    "publish": [
      {
        "provider": "github",
        "owner": "dasdkslkd",
        "repo": "ChatTree",
        "private": true,
        "releaseType": "draft"
      }
    ],
    "directories": {
      "output": "../dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "frontend"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "../dist/chattree-launcher.exe",
          "to": "chattree-launcher.exe"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "../dist/chattree-launcher",
          "to": "chattree-launcher"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "extraResources": [
        {
          "from": "../dist/chattree-launcher",
          "to": "chattree-launcher"
        }
      ]
    }
  }
}
